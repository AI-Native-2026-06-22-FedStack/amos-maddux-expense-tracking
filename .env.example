# path: .env.example
# Commit the EXAMPLE only; never commit the real .env. The argon2id costs are a
# security decision you tune in Task 2; the RS256 key material is loaded at
# runtime, not pasted into source.
DATABASE_URI=postgres://localhost:5432/expenseflow
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
JWT_ISSUER=expense-api
JWT_AUDIENCE=expense-clients
JWT_KEY_ID=local-development-key
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
# Prefer runtime secrets or local ignored files. Never paste real key material here.
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt-public.pem
