# path: .env.example
# Commit the EXAMPLE only; never commit the real .env. Runtime secrets live in
# floci-backed AWS Secrets Manager and are referenced here by SecretId only.

# Local AWS emulator configuration used by AWS SDK/CLI clients on the host.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Docker Compose services use the emulator service name on the shared network.
COMPOSE_AWS_ENDPOINT_URL=http://floci:4566

# CloudFront + S3 SPA deploy settings for local floci only.
SPA_BUCKET_NAME=expenseflow-spa-m7d5
SPA_DISTRIBUTION_ID=
API_CORS_ALLOWED_ORIGIN=http://expenseflow-spa-cloudfront-floci.cloudfront.localhost
VITE_EXPENSEFLOW_API_BASE_URL=http://expenseflow-public-alb.localhost/v1

# SecretId values for runtime secrets stored outside the .env file.
DB_PASSWORD_SECRET_ID=expenseflow/local/db-password
JWT_SIGNING_KEYS_SECRET_ID=expenseflow/local/jwt-signing-keys

# Local persistence endpoints for the API and supporting stores.
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=synthetic-compose-db-password
POSTGRES_DB=expenseflow
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
FLOCI_HOST_PORT=4566
TIVS_ACL_HOST_PORT=3015
DATABASE_URI=postgres://expenseflow@localhost:5433/expenseflow
REDIS_URL=redis://localhost:6379
COMPUTE_SERVICE_URL=http://localhost:8000
TIVS_ACL_URL=http://localhost:3015

# Password hashing cost settings for local authentication flows.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Expense Report write throttling and slow-down controls.
EXPENSE_WRITE_RATE_LIMIT_WINDOW_MS=60000
EXPENSE_WRITE_RATE_LIMIT_MAX=120
EXPENSE_WRITE_SLOW_DOWN_AFTER=80
EXPENSE_WRITE_DELAY_INCREMENT_MS=250
EXPENSE_WRITE_MAX_DELAY_MS=5000

# JWT issuer, audience, key selection, and token lifetime settings.
JWT_ISSUER=expense-api
JWT_AUDIENCE=expense-clients
JWT_KEY_ID=local-development-key
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Local SNS/SQS resource names for Expense Report stage-transitioned events.
SNS_STAGE_EVENTS_TOPIC=expenseflow-stage-events
SQS_STAGE_EVENTS_QUEUE=expenseflow-stage-projection
SQS_STAGE_EVENTS_DLQ=expenseflow-stage-projection-dlq

# Local SNS/SQS resource names for services/pipeline's dataset-refreshed
# events (same Module 6 SNS->SQS pattern, own topic/queue -- see
# docs/adr/0014-event-taxonomy-and-cloudevents.md and
# services/pipeline/sns_publisher.py). Separate from SNS_STAGE_EVENTS_TOPIC
# because that topic's consumer strictly parses only the
# stage-transitioned event type.
SNS_PIPELINE_DATASET_EVENTS_TOPIC=expenseflow-pipeline-dataset-events
SQS_PIPELINE_DATASET_REFRESHED_QUEUE=expenseflow-pipeline-dataset-refreshed
SQS_PIPELINE_DATASET_REFRESHED_DLQ=expenseflow-pipeline-dataset-refreshed-dlq

# services/pipeline's analytics schema (owned by the pipeline only; never an
# apps/api or services/compute operational schema/table -- see
# services/pipeline/db/migrations/0001_pipeline_analytics_schema.sql).
PIPELINE_ANALYTICS_SCHEMA=pipeline_analytics

# services/pipeline's quarantine bucket/prefix on floci S3 for rows that
# fail semantic data-quality validation (see services/pipeline/quarantine.py
# and quality.py). Uses the same AWS_ENDPOINT_URL/AWS_REGION as every other
# floci client above.
PIPELINE_QUARANTINE_BUCKET=expenseflow-pipeline-quarantine
PIPELINE_QUARANTINE_PREFIX=quarantine

# CloudWatch metric namespace for services/pipeline's own operational
# metrics (quarantine rate -- see services/pipeline/quarantine_rate.py).
# Uses the same AWS_ENDPOINT_URL/AWS_REGION as every other floci client
# above. The quarantine-rate failure threshold itself is a policy value,
# not an environment detail, and lives in services/pipeline/pipeline.toml.
PIPELINE_CLOUDWATCH_NAMESPACE=ExpenseFlow/Pipeline

# TIVS ACL legacy SOAP integration.
TIVS_WSDL_URL=https://d2xnf2iv2yptek.cloudfront.net/tivs?wsdl
TIVS_ENDPOINT_URL=https://d2xnf2iv2yptek.cloudfront.net/tivs
TIVS_USERNAME=
TIVS_PASSWORD=
TIVS_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
TIVS_BREAKER_VOLUME_THRESHOLD=3
TIVS_BREAKER_RESET_TIMEOUT_MS=5000
TIVS_BREAKER_TIMEOUT_MS=1000
