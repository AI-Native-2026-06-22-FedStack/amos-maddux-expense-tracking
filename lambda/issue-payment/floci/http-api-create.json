    "AllowCredentials": false,
    "AllowHeaders": ["Authorization", "Content-Type", "X-Correlation-Id", "Idempotency-Key"],
    "AllowMethods": ["GET", "POST", "PATCH", "OPTIONS"],
    "AllowOrigins": ["${api_cors_allowed_origin}"]
  }
}
