{
  "api": {
    "Name": "expenseflow-issue-payment-http-api",
    "ProtocolType": "HTTP"
  },
  "integration": {
    "IntegrationType": "AWS_PROXY",
    "IntegrationMethod": "POST",
    "IntegrationUri": "${issue_payment_function_uri}",
    "PayloadFormatVersion": "2.0"
  },
  "route": {
