{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Expire untagged images beyond the newest two so abandoned layers do not accumulate.",
      "selection": {
        "tagStatus": "untagged",
        "countType": "imageCountMoreThan",
        "countNumber": 2
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Keep the newest ten m7d3 fixed-version images and expire older m7d3 tags.",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["m7d3-"],
        "countType": "imageCountMoreThan",
        "countNumber": 10
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
