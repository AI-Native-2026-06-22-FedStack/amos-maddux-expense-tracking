{
  "name": "expenseflow",
  "version": "0.1.0",
  "description": "ExpenseFlow TypeScript Node bootstrap.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p apps/api/tsconfig.json",
    "dev": "tsx watch apps/api/src/server.ts",
    "lint": "eslint . --max-warnings=0 && prettier . --check",
    "test": "vitest run --config vitest.config.ts && cd apps/api && vitest run --config vitest.config.ts",
    "check": "npm run build && npm run lint && npm test",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@scalar/express-api-reference": "^0.10.8",
    "argon2": "^0.44.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.5.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "light-my-request": "^6.6.0",
    "pg": "^8.22.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.22.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
